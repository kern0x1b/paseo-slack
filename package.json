{
  "name": "paseo-slack",
  "version": "1.1.0",
  "description": "A mini Slack inside Paseo: full Web API access, personal identity, zero-cost real-time event router, and MCP tools for AI fleets.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "slack": "./bin/slack.js",
    "paseo-slack": "./bin/slack.js"
  },
  "scripts": {
    "start": "node ./bin/slack.js",
    "daemon": "node ./bin/slack.js daemon",
    "mcp": "node ./bin/slack.js mcp",
    "test": "node --test test/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "keywords": [
    "slack",
    "paseo",
    "ai-agents",
    "mcp",
    "router",
    "cli"
